rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.createdAt == request.time;
    }

    function isValidEntry(data) {
      return data.keys().hasAll(['userId', 'timestamp', 'type'])
        && data.userId == request.auth.uid
        && data.timestamp is timestamp
        && data.type in ['cigarette', 'other']
        && (!('price' in data) || (data.price is int || data.price is float))
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 100))
        && (!('intensity' in data) || data.intensity is int)
        && (!('mood' in data) || data.mood is string && data.mood.size() <= 100)
        && (!('trigger' in data) || data.trigger is string && data.trigger.size() <= 100)
        && (!('note' in data) || data.note is string && data.note.size() <= 500);
    }

    function isValidDailySummary(data) {
      return data.keys().hasAll(['userId', 'date', 'count', 'totalSpent', 'lastUpdated'])
        && data.userId == request.auth.uid
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.count is int && data.count >= 0
        && (data.totalSpent is int || data.totalSpent is float)
        && data.lastUpdated == request.time;
    }

    // --- Match Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (
          // Action: Complete Onboarding
          (incoming().diff(existing()).affectedKeys().hasOnly(['onboardingComplete', 'dailyGoal']))
          || (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']))
        );
    }

    match /users/{userId}/entries/{entryId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(entryId) && isValidEntry(incoming());
      allow update, delete: if isOwner(userId); // Entries are mostly private, owner can manage. But let's harden update.
      allow update: if isOwner(userId)
        && incoming().userId == existing().userId
        && incoming().timestamp == existing().timestamp
        && (incoming().diff(existing()).affectedKeys().hasOnly(['type', 'price', 'intensity', 'mood', 'trigger', 'note']));
    }

    match /users/{userId}/dailySummaries/{summaryId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      // Summaries are updated by the client or functions. Here we allow client for MVP.
      allow create: if isOwner(userId) && isValidId(summaryId) && isValidDailySummary(incoming());
      allow update: if isOwner(userId)
        && incoming().userId == existing().userId
        && incoming().date == existing().date
        && (incoming().diff(existing()).affectedKeys().hasOnly(['count', 'totalSpent', 'lastUpdated']));
    }
  }
}
